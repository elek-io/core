{
  "name": "@elek-io/core",
  "version": "0.23.0",
  "description": "Handles core functionality of elek.io Projects like file IO and version control.",
  "homepage": "https://elek.io",
  "repository": "https://github.com/elek-io/core",
  "bugs": {
    "url": "https://github.com/elek-io/core/issues"
  },
  "type": "module",
  "bin": {
    "elek": "./dist/cli/index.cli.mjs"
  },
  "files": [
    "dist/node",
    "dist/browser",
    "dist/astro",
    "dist/cli",
    "docs"
  ],
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node/index.node.d.mts",
          "default": "./dist/node/index.node.mjs"
        }
      },
      "import": {
        "types": "./dist/browser/index.browser.d.ts",
        "default": "./dist/browser/index.browser.js"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro/index.astro.d.mts",
        "default": "./dist/astro/index.astro.mjs"
      }
    }
  },
  "scripts": {
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "release": "changeset publish"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@hono/zod-openapi": "1.5.1",
    "@scalar/hono-api-reference": "0.11.11",
    "@sindresorhus/slugify": "3.0.0",
    "fs-extra": "11.4.0",
    "hono": "4.12.34",
    "mime": "4.1.0",
    "p-queue": "9.3.3",
    "semver": "7.8.5",
    "uuid": "14.0.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commander-js/extra-typings": "15.0.0",
    "@faker-js/faker": "10.5.0",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/fs-extra": "11.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.1.4",
    "chokidar": "5.0.0",
    "code-block-writer": "13.0.3",
    "commander": "15.0.0",
    "dugite": "3.2.2",
    "jiti": "2.7.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "astro": "^6.1.3 || ^7.0.0",
    "dugite": "^3.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.5.0"
}
