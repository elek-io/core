{
  "name": "@elek-io/core",
  "version": "0.25.1",
  "description": "Handles core functionality of elek.io Projects like file IO and version control.",
  "homepage": "https://elek.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elek-io/core.git"
  },
  "bugs": {
    "url": "https://github.com/elek-io/core/issues"
  },
  "type": "module",
  "bin": {
    "elek": "./dist/cli/index.cli.mjs"
  },
  "files": [
    "dist/node",
    "dist/browser",
    "dist/astro",
    "dist/cli",
    "docs"
  ],
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node/index.node.d.mts",
          "default": "./dist/node/index.node.mjs"
        }
      },
      "import": {
        "types": "./dist/browser/index.browser.d.ts",
        "default": "./dist/browser/index.browser.js"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro/index.astro.d.mts",
        "default": "./dist/astro/index.astro.mjs"
      }
    },
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "release": "changeset publish"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.13",
    "@sindresorhus/slugify": "3.0.1",
    "fs-extra": "11.4.1",
    "hono": "4.13.13",
    "mime": "4.1.1",
    "p-queue": "10.0.0",
    "semver": "7.8.5",
    "uuid": "14.0.3",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commander-js/extra-typings": "15.0.0",
    "@faker-js/faker": "10.6.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/fs-extra": "11.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.2",
    "chokidar": "6.0.0",
    "code-block-writer": "13.0.3",
    "commander": "15.0.0",
    "dugite": "3.3.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "astro": "^6.1.3 || ^7.0.0",
    "dugite": "^3.2.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^4.6.6"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.15.0"
}
